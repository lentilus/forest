#import "/_lib/0.1.1.typ": *
#show: template

// #taxon[Taxon]
#title[Zeta Species]

Given $X : "FinCommRing" -> "FinSet"$, define
$
  Z_X (A) :-= sum_(R : "FinSemisimpleCommRing") (U(R)~= A) xx X(R),
$
where $U(R)$ is the underlying type of $R$. See also #local("00B8")[Hasse-Weil species in agda-unimath]
