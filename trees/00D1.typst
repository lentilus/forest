  "Elimination"
  (Gamma tack a:A quad Gamma, x:A, p:"Id"_A (a,x) tack P(x,p) "type")/
  (Gamma tack J_a : P(a,"refl"_a) ->  Pi_(x:A) Pi_(p : "Id"_A (a,x)) P(x,p))
$

